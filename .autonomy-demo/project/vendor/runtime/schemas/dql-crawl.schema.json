{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"subactor.dql-crawl/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","sitemapUrls","seedUrls","allowHosts","includePaths","excludePaths","contextTerms","maxUrls","maxSitemaps","sameOriginOnly","respectRobots","output","validations"],
  "properties":{
    "schema":{"const":"subactor.dql-crawl/v1"},
    "id":{"type":"string","minLength":1},
    "sitemapUrls":{"type":"array","items":{"type":"string","format":"uri"},"uniqueItems":true},
    "seedUrls":{"type":"array","items":{"type":"string","format":"uri"},"uniqueItems":true},
    "allowHosts":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "includePaths":{"type":"array","items":{"type":"string"}},
    "excludePaths":{"type":"array","items":{"type":"string"}},
    "contextTerms":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "maxUrls":{"type":"integer","minimum":1,"maximum":5000},
    "maxSitemaps":{"type":"integer","minimum":1,"maximum":100},
    "sameOriginOnly":{"type":"boolean"},
    "respectRobots":{"type":"boolean"},
    "output":{"const":"markdown"},
    "validations":{"type":"array","items":{"type":"string"},"uniqueItems":true}
  }
}
