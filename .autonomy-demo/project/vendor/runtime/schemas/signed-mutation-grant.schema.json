{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subactor.local/schemas/signed-mutation-grant.schema.json",
  "title": "SignedMutationGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "planHash",
    "artifactSha256",
    "target",
    "actor",
    "riskClass",
    "jti",
    "iat",
    "expiresAt",
    "runId",
    "intentPack",
    "signature",
    "grantHash"
  ],
  "properties": {
    "schema": { "const": "subactor.signed-mutation-grant/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "minLength": 16 },
    "artifactSha256": { "type": "string", "minLength": 16 },
    "target": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "riskClass": {
      "enum": ["read_only", "reversible", "boundary", "governance"]
    },
    "jti": { "type": "string", "minLength": 8 },
    "iat": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 1 },
    "intentPack": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "string",
      "description": "Compact HS256 token base64url(header).base64url(payload).base64url(sig)"
    },
    "grantHash": { "type": "string", "minLength": 16 }
  }
}
