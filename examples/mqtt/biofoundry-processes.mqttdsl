MQTT_BINDINGS biofoundry-uri-processes
DEFAULT_MODE simulation
AUTHORITY observe-only
BROKER "local"
URL_ENV MQTT_URL
CLIENT_ID "biofoundry-dashboard"
KEEP_ALIVE_SECONDS 30
END_BROKER
PROCESS_ROUTE "laboratory-manipulation"
BROKER_ID "local"
TOPIC "biofoundry/{mode}/process/laboratory_manipulation/events"
QOS 1
PROCESS_ID "laboratory_manipulation"
PROCESS_URI twin://biofoundry/process/query/laboratory_manipulation
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
PROCESS_ROUTE "closed-optimization"
BROKER_ID "local"
TOPIC "biofoundry/{mode}/process/closed_optimization/events"
QOS 1
PROCESS_ID "closed_optimization"
PROCESS_URI twin://biofoundry/process/query/closed_optimization
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
PROCESS_ROUTE "cultivation-monitoring"
BROKER_ID "local"
TOPIC "biofoundry/{mode}/process/cultivation_monitoring/events"
QOS 1
PROCESS_ID "cultivation_monitoring"
PROCESS_URI twin://biofoundry/process/query/cultivation_monitoring
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
