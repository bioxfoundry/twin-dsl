PROCESS_URI twin://biofoundry/process/query/microfluidic_sample_preparation
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
PROCESS_ROUTE "syringebot-synthesis"
BROKER_ID "local"
TOPIC "biofoundry/{mode}/process/syringebot_synthesis/events"
QOS 1
PROCESS_ID "syringebot_synthesis"
PROCESS_URI twin://biofoundry/process/query/syringebot_synthesis
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
PROCESS_ROUTE "plasmid-cloning"
BROKER_ID "local"
TOPIC "biofoundry/{mode}/process/plasmid_cloning/events"
QOS 1
PROCESS_ID "plasmid_cloning"
PROCESS_URI twin://biofoundry/process/query/plasmid_cloning
MODES [simulation,shadow,hardware]
END_PROCESS_ROUTE
END_MQTT_BINDINGS
