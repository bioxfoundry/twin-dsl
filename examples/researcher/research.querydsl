QUERY biofoundry-evidence-query
INTENT urn:subactor:intent:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PROCESS query://knowledge/clickhouse/search/execute
SOURCES [__SOURCE__]
SNAPSHOT __SNAPSHOT__
FILTER text contains "bioreactor"
RETURN tree
RESULT_URI urn:subactor:query-result:sha256:{hash}
VALIDATE [evidence-present, immutable-result-uri, snapshot-bound]
