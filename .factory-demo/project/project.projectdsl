PROJECT biofoundry-factory-floor
NAME "Biofoundry Factory Floor"
PROFILE biofoundry
MANAGER_INTENT "Run the biofoundry as a live physical twin."
SOURCE manager "data/manager" subactor://project/biofoundry-factory-floor/manager authority policy
SOURCE customer "data/customer" subactor://project/biofoundry-factory-floor/customer requirements
SOURCE project "data/project" subactor://project/biofoundry-factory-floor/data research
SOURCE archive "data/archives" subactor://project/biofoundry-factory-floor/archives historical
SOURCE derived "feedback" subactor://project/biofoundry-factory-floor/feedback feedback
SOURCE development "code" subactor://project/biofoundry-factory-floor/development code
SOURCE runtime "logs" subactor://project/biofoundry-factory-floor/logs runtime-log
SOURCE runtime "environment" subactor://project/biofoundry-factory-floor/environment environment
DEVELOPMENT_ROOT "code"
DEVELOPMENT_TASK "TASK.md"
DEVELOPMENT_TODO "TODO.md"
DEVELOPMENT_CHANGELOG "CHANGELOG.md"
DEVELOPMENT_DOCS ["README.md","docs/**/*.md"]
DEVELOPMENT_FIXTURE "config/development.intent.fixture.json"
OBSERVATION_PATHS ["logs","environment"]
OBSERVATION_ROOT subactor://project/biofoundry-factory-floor/runtime
POLICY_APPROVED true
POLICY_REQUIRE_RESEARCH true
POLICY_REQUIRE_DEVELOPMENT true
POLICY_REQUIRE_DEVELOPMENT_ACCEPTANCE true
POLICY_ALLOW_DEVELOPMENT_FIXTURE true
POLICY_REQUIRE_RUNTIME true
POLICY_AUTO_PUBLISH_SCENE true
POLICY_ALLOW_RUNTIME_SELF_MODIFICATION false
POLICY_AUTONOMY_MODE propose
POLICY_REQUIRE_SIGNED_MUTATION_GRANT true
POLICY_MAX_ITERATIONS_PER_HOUR 12
POLICY_MAX_CONSECUTIVE_FAILURES 5
SCENE_FORMAT openusd
SCENE_BLUEPRINT_FILE "baseline/scene-blueprint.json"
SCENE_PHYSICAL_EVIDENCE_FILE "baseline/physical-evidence.json"
