EXPR ResearchGate = OR(NOT(RequireResearch), ResearchEvidencePresent)
EXPR DevelopmentGate = AND(OR(NOT(RequireDevelopment), DevelopmentEvidencePresent), OR(NOT(RequireDevelopmentAcceptance), DevelopmentAccepted))
EXPR RuntimeGate = OR(NOT(RequireRuntime), RuntimeEvidencePresent)
EXPR MutationGrantGate = OR(NOT(RequireSignedMutationGrant), SignedMutationGrantPresent)
EXPR IterationAllowed = AND(ManagerApproved, RateLimitAvailable, ResearchGate, DevelopmentGate, RuntimeGate)
EXPR ScenePublishAllowed = AND(IterationAllowed, AutoPublishScene)
EXPR RuntimeSelfModificationAllowed = AND(IterationAllowed, AllowRuntimeSelfModification, AutonomyModeApply, MutationGrantGate, DevelopmentAccepted)
EXPR ConceptScenePublishAllowed = AND(HasSemanticArchitecture, HasEvidenceProvenance, GeometryExplicitlyPlaceholder, ManagerApprovedConceptScene)
EXPR PhysicalTwinReady = AND(HasFacilityFloorplan, HasCertifiedCoordinates, HasEquipmentDimensions, HasUtilityNetwork)
EXPR OperationalTwinReady = AND(PhysicalTwinReady, HasTelemetryBindings)