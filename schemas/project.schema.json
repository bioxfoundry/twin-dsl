{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.living-project/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "profile",
    "managerIntent",
    "sources",
    "development",
    "observations",
    "policy",
    "scene"
  ],
  "properties": {
    "schema": {
      "const": "subactor.living-project/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "generic",
        "biofoundry"
      ]
    },
    "managerIntent": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "logicalRoot"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "enum": [
              "manager",
              "customer",
              "project",
              "internet",
              "archive",
              "derived",
              "runtime",
              "development"
            ]
          },
          "logicalRoot": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "development": {
      "type": "object"
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "logicalRoot"],
      "properties": {
        "paths": {"type":"array","items":{"type":"string"}},
        "logicalRoot": {"type":"string"},
        "liveBindingFile": {"type":"string"},
        "mqttBindingFile": {"type":"string"}
      }
    },
    "webResearch": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "required": [
        "approved",
        "requireResearch",
        "requireDevelopmentEvidence",
        "requireDevelopmentAcceptance",
        "allowDevelopmentFixture",
        "requireRuntimeEvidence",
        "autoPublishScene",
        "allowRuntimeSelfModification",
        "autonomyMode",
        "requireSignedMutationGrant",
        "maxIterationsPerHour",
        "maxConsecutiveFailures"
      ],
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "requireResearch": {
          "type": "boolean"
        },
        "requireDevelopmentEvidence": {
          "type": "boolean"
        },
        "requireDevelopmentAcceptance": {
          "type": "boolean"
        },
        "allowDevelopmentFixture": {
          "type": "boolean"
        },
        "requireRuntimeEvidence": {
          "type": "boolean"
        },
        "autoPublishScene": {
          "type": "boolean"
        },
        "allowRuntimeSelfModification": {
          "type": "boolean"
        },
        "autonomyMode": {
          "enum": [
            "observe",
            "propose",
            "apply"
          ]
        },
        "requireSignedMutationGrant": {
          "type": "boolean"
        },
        "mutationGrantFile": {
          "type": "string"
        },
        "maxIterationsPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxConsecutiveFailures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "openusd",
            "gltf",
            "3dtiles"
          ]
        },
        "blueprintFile": {"type": "string"},
        "physicalEvidenceFile": {"type": "string"},
        "assemblyFile": {"type": "string"},
        "geometryBuildFiles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
