{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioxfoundry.dev/schemas/document-structure.schema.json",
  "title": "Canonical document block structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "sourceSha256", "rawMarkdownSha256", "canonicalMarkdownSha256", "pages", "blocks", "ocr"],
  "properties": {
    "schema": { "const": "bioxfoundry.document-structure/v1" },
    "source": { "type": "string", "minLength": 1 },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawMarkdownSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalMarkdownSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceModel": { "type": "string" },
    "documentAstSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "width", "height"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "width": { "type": ["number", "null"] },
          "height": { "type": ["number", "null"] }
        }
      }
    },
    "layoutAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "engine", "version", "eligibleBlocks", "mappedBlocks", "coverage", "reason"],
      "properties": {
        "status": { "enum": ["pass", "degraded", "not-run"] },
        "engine": { "type": "string" },
        "version": { "type": "string" },
        "eligibleBlocks": { "type": "integer", "minimum": 0 },
        "mappedBlocks": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "page", "bbox", "semantic", "confidence", "normalizedText"],
        "properties": {
          "id": { "type": "string", "pattern": "^block-[a-f0-9]{16}$" },
          "type": { "enum": ["paragraph", "heading", "list", "table", "code", "figure", "diagram", "equation", "chart", "caption"] },
          "page": { "type": "integer", "minimum": 1 },
          "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "bbox": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            ]
          },
          "semantic": { "type": "boolean" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "normalizedText": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "language": { "type": "string" },
          "asset": { "type": "string" },
          "alt": { "type": "string" },
          "assetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "type": "string", "pattern": "^image/" },
          "reason": { "type": "string" },
          "artifactId": { "type": "string" },
          "artifactUrn": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocrRequested", "ocrActuallyUsed", "ocrEngine", "ocrVersion", "ocrLanguages", "ocrPages", "ocrRegions", "ocrConfidence"],
      "properties": {
        "ocrRequested": { "type": "boolean" },
        "ocrActuallyUsed": { "type": "boolean" },
        "ocrEngine": { "type": "string" },
        "ocrVersion": { "type": "string" },
        "ocrLanguages": { "type": "array", "items": { "type": "string" } },
        "ocrPages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "ocrRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["page", "bbox", "kind", "engine", "confidence"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
              "kind": { "type": "string" },
              "asset": { "type": "string" },
              "engine": { "type": "string" },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "ocrConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
