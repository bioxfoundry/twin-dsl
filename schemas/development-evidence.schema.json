{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.development-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "graphFingerprint",
    "recordCount",
    "relationCount",
    "diagnosticCount",
    "blockingDiagnosticCount",
    "acceptance",
    "manifestStatus",
    "evidenceUris"
  ],
  "properties": {
    "schema": {
      "const": "subactor.development-evidence/v1"
    },
    "source": {
      "enum": [
        "todo2code",
        "fixture",
        "missing"
      ]
    },
    "graphFingerprint": {
      "type": "string"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "relationCount": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticCount": {
      "type": "integer",
      "minimum": 0
    },
    "blockingDiagnosticCount": {
      "type": "integer",
      "minimum": 0
    },
    "acceptance": {
      "enum": [
        "accepted",
        "review_required",
        "rejected",
        "unknown"
      ]
    },
    "manifestStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceUris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
