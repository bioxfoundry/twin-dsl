{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioxfoundry.dev/schemas/diagram-graph.schema.json",
  "title": "Deterministic semantic graph reconstructed from a document diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generation", "sourceTextSha256", "nodes", "edges", "validation"],
  "properties": {
    "schema": { "const": "f2md.diagram-graph/v1" },
    "generation": { "enum": ["deterministic-ascii-v1", "deterministic-layout-v1"] },
    "sourceTextSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "sourceLines"],
        "properties": {
          "id": { "type": "string", "pattern": "^node-[a-z0-9-]+-[a-f0-9]{10}$" },
          "label": { "type": "string", "minLength": 2 },
          "sourceLines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "directed", "confidence", "sourceLines"],
        "properties": {
          "id": { "type": "string", "pattern": "^edge-[a-f0-9]{10}$" },
          "from": { "type": "string", "pattern": "^node-" },
          "to": { "type": "string", "pattern": "^node-" },
          "directed": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceLines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "nodes", "edges", "nodeLabelsInSource", "labelCoverage", "danglingEdges", "meanEdgeConfidence", "sourceHashMatches"],
      "properties": {
        "valid": { "type": "boolean" },
        "nodes": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "nodeLabelsInSource": { "type": "integer", "minimum": 0 },
        "labelCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "danglingEdges": { "type": "integer", "minimum": 0 },
        "meanEdgeConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "sourceHashMatches": { "type": "boolean" }
      }
    }
  }
}
