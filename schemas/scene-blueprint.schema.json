{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.scene-blueprint/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","twinKind","components","bindings"],
  "properties": {
    "schema": {"const":"subactor.scene-blueprint/v1"},
    "id": {"type":"string","minLength":1},
    "twinKind": {"enum":["actor","system","process","physical","conceptual"]},
    "components": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","type","sourceRoles"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "type":{"type":"string","minLength":1},
          "label":{"type":"string"},
          "sourceRoles":{"type":"array","items":{"enum":["manager","customer","project","internet","archive","derived","runtime","development"]},"uniqueItems":true},
          "pathIncludes":{"type":"array","items":{"type":"string"}},
          "pathExcludes":{"type":"array","items":{"type":"string"}},
          "maxSourceUris":{"type":"integer","minimum":1,"maximum":500},
          "properties":{"type":"object"},
          "includeDevelopmentEvidence":{"type":"boolean"},
          "includeRuntimeObservations":{"type":"boolean"}
        }
      }
    },
    "bindings": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["componentId","scenePath"],
        "properties": {
          "componentId":{"type":"string"},
          "scenePath":{"type":"string","pattern":"^/"},
          "primitive":{"enum":["cube","cylinder","sphere","scope"]},
          "position":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
          "size":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
          "orientation":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},
          "propertyMap":{"type":"object","additionalProperties":{"type":"string"}}
        }
      }
    }
  }
}
