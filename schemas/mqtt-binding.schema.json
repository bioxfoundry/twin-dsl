{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.mqtt-binding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "defaultMode", "brokers", "processRoutes", "authority"],
  "properties": {
    "schema": {"const": "subactor.mqtt-binding/v1"},
    "id": {"type": "string", "minLength": 1},
    "defaultMode": {"enum": ["simulation", "shadow", "hardware"]},
    "authority": {"const": "observe-only"},
    "brokers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "urlEnv", "clientId", "keepAliveSeconds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "urlEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "clientId": {"type": "string", "minLength": 1, "maxLength": 128},
          "keepAliveSeconds": {"type": "integer", "minimum": 5, "maximum": 3600}
        }
      }
    },
    "processRoutes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "brokerId", "topic", "qos", "processId", "processUri", "modes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "brokerId": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1, "pattern": "^(?!.*[+#]).+$"},
          "qos": {"enum": [0, 1]},
          "processId": {"type": "string", "minLength": 1},
          "processUri": {"type": "string", "pattern": "^twin://[a-z0-9.-]+/process/query/[a-z0-9._~-]+$"},
          "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["simulation", "shadow", "hardware"]}}
        }
      }
    }
  }
}
