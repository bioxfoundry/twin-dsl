{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subactor.local/schemas/mutation-proposal-receipt.schema.json",
  "title": "MutationProposalReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposalId",
    "projectId",
    "mode",
    "status",
    "startedAt",
    "completedAt",
    "planHash",
    "grantVerified",
    "grantJti",
    "actor",
    "developmentRoot",
    "workspace",
    "sourcePatchUri",
    "sourcePatchPath",
    "failures",
    "stages",
    "proposalUri"
  ],
  "properties": {
    "schema": { "const": "subactor.mutation-proposal-receipt/v1" },
    "proposalId": { "type": "string" },
    "projectId": { "type": "string" },
    "mode": { "enum": ["propose", "apply"] },
    "status": {
      "enum": ["proposed", "refused", "failed", "applied-isolated"]
    },
    "startedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "planHash": { "type": "string" },
    "grantVerified": { "type": "boolean" },
    "grantJti": { "type": ["string", "null"] },
    "actor": { "type": "string" },
    "developmentRoot": { "type": "string" },
    "workspace": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["git-worktree", "directory-copy"] },
            "path": { "type": "string" },
            "branch": { "type": "string" }
          }
        }
      ]
    },
    "sourcePatchUri": { "type": ["string", "null"] },
    "sourcePatchPath": { "type": ["string", "null"] },
    "closeResultUri": { "type": ["string", "null"] },
    "closeResultPath": { "type": ["string", "null"] },
    "allAccepted": { "type": ["boolean", "null"] },
    "failures": { "type": "array", "items": { "type": "string" } },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "enum": ["grant", "isolate", "propose-source-patch", "apply-source-patch", "re-analyze", "close-code-change"]
          },
          "status": { "enum": ["succeeded", "blocked", "failed"] },
          "reason": { "type": "string" }
        }
      }
    },
    "proposalUri": { "type": "string" }
  }
}
