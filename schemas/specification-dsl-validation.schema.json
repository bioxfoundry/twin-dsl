{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subactor.dev/schemas/specification-dsl-validation.schema.json",
  "title": "Specification Markdown, intentDSL and Twin validation report",
  "type": "object",
  "required": ["schema", "status", "inputs", "summary", "documents", "twin", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "bioxfoundry.specification-dsl-validation/v1" },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "inputs": {
      "type": "object",
      "required": ["sourceDir", "markdownDir", "dslDir"],
      "additionalProperties": false,
      "properties": {
        "sourceDir": { "type": "string", "minLength": 1 },
        "markdownDir": { "type": "string", "minLength": 1 },
        "dslDir": { "type": "string", "minLength": 1 },
        "blueprintPath": { "type": "string", "minLength": 1 },
        "intentIndexPath": { "type": "string", "minLength": 1 },
        "twinPath": { "type": "string", "minLength": 1 },
        "scenePath": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["documents", "checks", "errors", "warnings", "info"],
      "additionalProperties": false,
      "properties": {
        "documents": { "type": "integer", "minimum": 0 },
        "checks": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document", "sourceSha256", "sourcePages", "translatedPages", "sourceDiagrams", "translatedDiagrams", "intentRecords", "intentPages", "status"],
        "additionalProperties": false,
        "properties": {
          "document": { "type": "string", "minLength": 1 },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceMarkdown": { "type": "string", "minLength": 1 },
          "translatedMarkdown": { "type": "string", "minLength": 1 },
          "sourcePages": { "type": "integer", "minimum": 0 },
          "translatedPages": { "type": "integer", "minimum": 0 },
          "sourceDiagrams": { "type": "integer", "minimum": 0 },
          "translatedDiagrams": { "type": "integer", "minimum": 0 },
          "intentRecords": { "type": "integer", "minimum": 0 },
          "intentPages": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }
        }
      }
    },
    "twin": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "componentCount": { "type": "integer", "minimum": 0 },
        "bindingCount": { "type": "integer", "minimum": 0 },
        "activeComponentCount": { "type": "integer", "minimum": 0 },
        "activeBindingCount": { "type": "integer", "minimum": 0 },
        "requiredComponents": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "groundedRequiredComponents": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "canonicalIntentPrioritized": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message", "remediation"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^SPEC_[A-Z0-9_]+$" },
          "severity": { "enum": ["error", "warning", "info"] },
          "path": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "document": { "type": "string", "minLength": 1 },
          "recordId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
