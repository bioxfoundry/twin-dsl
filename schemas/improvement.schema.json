{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.improvement-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "projectId",
    "mode",
    "generatedAt",
    "sourceIterationUri",
    "evidenceUris",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "subactor.improvement-plan/v1"
    },
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "mode": {
      "const": "propose_only"
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceIterationUri": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceUris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "reason",
          "targetUris",
          "approvalRequired",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "research",
              "development",
              "runtime",
              "policy",
              "validation",
              "deployment"
            ]
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "targetUris": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "approvalRequired": {
            "type": "boolean"
          },
          "status": {
            "const": "proposed"
          }
        }
      }
    }
  }
}
