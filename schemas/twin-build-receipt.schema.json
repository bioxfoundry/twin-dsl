{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.twin-build-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "sourceSnapshotHash",
    "previousSnapshotHash",
    "diff",
    "treeUri",
    "mathUri",
    "twinUri",
    "sceneUri",
    "validation",
    "generatedAt"
  ],
  "properties": {
    "schema": {
      "const": "subactor.twin-build-receipt/v1"
    },
    "runId": {
      "type": "string"
    },
    "sourceSnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousSnapshotHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "diff": {
      "type": "object"
    },
    "treeUri": {
      "type": "string"
    },
    "mathUri": {
      "type": "string"
    },
    "twinUri": {
      "type": "string"
    },
    "sceneUri": {
      "type": "string"
    },
    "validation": {
      "type": "object",
      "required": [
        "ok",
        "checks",
        "failures"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "noChange": {
      "type": "boolean"
    }
  }
}
