{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subactor.living-failure/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "failureId",
    "traceId",
    "occurredAt",
    "configPath",
    "outputDirectory",
    "consecutiveFailures",
    "errorCode",
    "message",
    "retryAfterMs"
  ],
  "properties": {
    "schema": {
      "const": "subactor.living-failure/v1"
    },
    "projectId": {
      "type": "string"
    },
    "failureId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string"
    },
    "configPath": {
      "type": "string"
    },
    "outputDirectory": {
      "type": "string"
    },
    "consecutiveFailures": {
      "type": "integer",
      "minimum": 1
    },
    "errorCode": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "retryAfterMs": {
      "type": "integer",
      "minimum": 0
    }
  }
}
