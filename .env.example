# todo2code – canonical intentDSL engine
T2C_ROOT=/home/tom/github/semcod/todo2code
T2C_BIN=/home/tom/github/semcod/todo2code/dist/src/cli.js
T2C_HOST_ROOT=/home/tom/github/semcod/todo2code
T2C_NL_MODE=require-llm

# subactor/twin-probes runs directly from its source checkout; no dist build is required.
TWIN_PROBES_ROOT=/home/tom/github/subactor/twin-probes
# Optional override. When omitted, the adapter derives <root>/src/run.mjs.
# TWIN_PROBES_BIN=/home/tom/github/subactor/twin-probes/src/run.mjs

# OpenRouter – NL -> query/tree/math/twin/scene/DQL/resource-plan
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/codestral-2508
OPENROUTER_HTTP_REFERER=https://subactor.com
OPENROUTER_APP_TITLE="Subactor Digital Twin Runtime"
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_TIMEOUT_MS=30000
DT_LLM_RESOURCE_CONTEXT_LIMIT=80
OPENROUTER_MAX_RETRIES=1
OPENROUTER_JSON_OBJECT_FALLBACK=false
OPENROUTER_RESPONSE_HEALING=false

# ClickHouse (docker compose) - the official image restricts user 'default' to 127.0.0.1
# unless these are set, which breaks every cross-container query with HTTP 401.
# Host ports published by `make up`; choose unused host ports if these conflict locally.
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=digital_twin
CLICKHOUSE_PASSWORD=digital_twin_local

# Docling (docker compose): conversion/OCR service. `make up` publishes container :5001 here.
DOCLING_PORT=15001
DOCLING_URL=http://127.0.0.1:15001

# Compose stack name; changing it creates separate Docker networks and volumes.
COMPOSE_PROJECT_NAME=subactor-digital-twin-runtime

# Docker network - pin the subnet when the host's default address pools are exhausted.
DT_NETWORK_SUBNET=10.201.7.0/24

# Runtime
DT_LLM_MODE=deterministic
DT_WATCH_INTERVAL_MS=2000
DT_MAX_ARCHIVE_FILES=1000
DT_MAX_ARCHIVE_ENTRY_BYTES=10485760
DT_MAX_TOTAL_ARCHIVE_BYTES=104857600
DT_CRAWLER_ALLOW_PRIVATE=false
DT_CRAWLER_USER_AGENT=SubactorResearchBot/0.2
